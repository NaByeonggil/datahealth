generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 제품유형
model ProductType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  formCode       String?  // TABLET, POWDER_STICK, LIQUID_STICK, JELLY_STICK, VIAL, SOFTCAPSULE ...
  category       String?  // 고형 / 액상 / 젤리 / 용기형 / 융복합
  defaultMoq     Int?     // 제형 기본 MOQ
  processingCost Float    @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  simpleQuotationProducts SimpleQuotationProduct[]
  processingCosts  ProcessingCost[]
  tollingRates     TollingRate[]
  tollingExtras    TollingExtra[]
  packagingSets    PackagingSet[]
}

// 가공비 이력
model ProcessingCost {
  id            String   @id @default(cuid())
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  cost          Float
  effectiveDate DateTime
  endDate       DateTime?
  changeReason  String?
  changedBy     String?
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 공급사
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("material") // material(원료) | tolling(임가공) | packaging(용기/자재)
  contact   String?
  manager   String?
  address   String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials     Material[]
  catalogItems  MaterialCatalog[]
  supplies      Supply[]
  tollingRates  TollingRate[]
  tollingExtras TollingExtra[]
  packagingSets PackagingSet[]
}

// 원료
model Material {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  code          String   @unique
  name          String
  category      String   @default("일반식품") // 건기식/일반식품
  origin        String?
  specification String?
  unit          String   @default("kg")
  unitPrice     Float
  minOrderQty   Float?
  packingUnit   Float?   // 포장단위 (예: 20 = 20kg/포)
  isFunctional  Boolean  @default(false)
  certifications String?
  note          String?
  updatedBy     String?  @default("관리자")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  priceHistory  MaterialPrice[]
  detailedItems DetailedMaterialItem[]
  catalogItems  MaterialCatalog[]
}

// 원료 가격 이력
model MaterialPrice {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  price        Float
  effectiveDate DateTime
  endDate      DateTime?
  changedBy    String?
  createdAt    DateTime @default(now())
}

// 공급사 취급품목 카탈로그 — 단가 없이 "취급 가능"만 관리
// 단가가 확보되면 Material 로 승격하고 materialId 로 연결한다
model MaterialCatalog {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  name          String              // 품목명
  category      String?             // 고시형 / 개별인정형 / 일반식품 / 생약원료 / 녹용제품 / 프로바이오틱스 ...
  origin        String?
  specification String?             // 함량·균수·규격
  packingUnit   Float?
  refCode       String?             // 고시번호(제2019-15호) 또는 브랜드명(Testofen)
  note          String?
  materialId    String?             // 단가 확보 후 승격된 Material
  material      Material? @relation(fields: [materialId], references: [id])
  sourceFile    String?             // 출처 파일명
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 같은 품목이라도 규격(수용성/불용성, 카테킨 30%/70%)·식품유형·제조사가 다르면
  // 별개의 취급품목이다. 자연키로 묶기에는 구분 축이 너무 많아 유니크 제약을 두지 않고,
  // 재실행 시 임포터가 sourceFile 단위로 지우고 다시 넣어 멱등성을 확보한다.
  @@index([supplierId])
  @@index([sourceFile])
  @@index([name])
}

// 일반견적서
model SimpleQuotation {
  id              String   @id @default(cuid())
  quotationNo     String   @unique
  productName     String
  customerName    String?



  // ── 견적서 양식용 (고객 발송 PDF) ──────────────────────
  /// 수신 담당자 (예: 김현우님)
  customerContact String?
  customerPhone   String?
  customerFax     String?
  /// 유효기간(일) — "견적일로부터 N일간"
  validDays       Int     @default(30)
  /// 납기 일자
  deliveryTerms   String?
  /// 결제 조건
  paymentTerms    String?
  /// 식품유형 — 건강기능식품 / 기타가공품 / 과채가공품 …
  /// 특기사항 조건부 문구(분석비·신고비·심의비)가 이 값으로 갈린다.
  foodType        String   @default("건강기능식품")
  /// 포장 옵션을 모두 발주하는가.
  /// false(기본) = 택일 — 30정/60정 중 고객이 고르는 경우라 합계가 의미 없다.
  /// true         = 합산 — 옵션을 모두 생산하므로 전 옵션 합계를 낸다.
  sumOptions      Boolean @default(false)

  totalMaterialCost Float  @default(0)
  totalAmount       Float  @default(0)

  note            String?

  products        SimpleQuotationProduct[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 일반견적서 원료 항목
// 포장 옵션 — 한 견적서에 30정/60정, 수량 구간 등을 여러 줄로 담는다.
// 배합(SimpleQuotationItem)은 1정당 값이라 옵션과 무관하게 공유한다.
// 견적서에 담기는 제품 — 정제·환제처럼 제형과 배합이 다른 제품을 한 장에 담는다.
// 배합(items)과 포장옵션(lines)은 제품에 붙는다.
model SimpleQuotationProduct {
  id            String   @id @default(cuid())
  quotationId   String
  quotation     SimpleQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder     Int      @default(1)
  /// 품목 표에 찍히는 제품명 (예: 모두의모발정제)
  name          String
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  /// 1정(1개)당 부원료비 — 제형마다 부형제가 달라 제품별로 둔다
  subMaterialCostPerUnit Float @default(20)
  /// 제품규격 (예: 1000mg정제)
  productSpec   String?
  /// 섭취방법 (예: 1일 3회 1정)
  dosage        String?

  items SimpleQuotationItem[]
  lines SimpleQuotationLine[]

  @@index([quotationId])
}

model SimpleQuotationLine {
  id               String   @id @default(cuid())
  productId        String
  product          SimpleQuotationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder        Int      @default(1)
  /// 옵션 표시명 — 비우면 "30정" 처럼 자동 생성
  label            String?
  packageUnit      Int
  bottleBoxCost    Float    @default(0)
  setCount         Int      @default(1)
  /// 포장방법 (예: 단상자*병*30정)
  packagingMethod  String?
  /// 수량 단위 (예: 박스, 20일분)
  unit             String   @default("박스")

  @@index([productId])
}

model SimpleQuotationItem {
  id                String   @id @default(cuid())
  productId         String
  product           SimpleQuotationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  sortOrder         Int
  category          String
  /// 주원료 / 부원료 — 특기사항의 원료 표기를 나눌 때 쓴다
  role              String   @default("주원료")
  materialName      String
  theoryAmount      Float    @default(0)
  actualAmount      Float    @default(0)
  kgUnitPrice       Float    @default(0)
  materialCost      Float    @default(0)
  origin            String?
}

// 상세견적서
model DetailedQuotation {
  id              String   @id @default(cuid())
  quotationNo     String   @unique
  productName     String
  customerName    String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  productType     String
  formType        String?
  contentAmount   Float?
  packageUnit     Int      @default(0)
  intakeGuide     String?

  // 제조 정보
  productionQty   Int      @default(0)   // 제조단위(총 생산 개수)
  unitWeight      Float    @default(0)   // 단위중량 CASE(g) = 내용량 x 포장단위
  totalWeight     Float    @default(0)   // 총중량(kg) = 내용량 x 제조단위 x 로스율 / 1000
  lossRate        Float    @default(1.1) // 총중량 산출 로스율 배수
  yieldRate       Float    @default(100) // 수율(%)
  theoreticalQty  Int      @default(0)   // 이론수량(case) = 제조단위 / 포장단위
  caseQty         Int      @default(0)   // 실제수량(case) - 1 case 원가 환산의 분모
  packagingMethod String?

  profitRate      Float    @default(5)   // 기업이윤(%)
  vatRate         Float    @default(10)  // 부가세율(%)
  finalUnitPrice  Float    @default(0)   // 확정 납품단가(VAT 포함, 수동 올림값)

  // 계산 스냅샷 - 저장 시점의 금액을 고정해 소급 변경을 막는다
  materialCost    Float    @default(0)   // 원료비 총액
  supplyCost      Float    @default(0)   // 자재비 총액
  processCost     Float    @default(0)   // 직접제조비 총액
  overheadCost    Float    @default(0)   // 간접제조비 총액
  costSubtotal    Float    @default(0)   // 1 case 원가
  profitAmount    Float    @default(0)   // 1 case 기업이윤
  unitPriceExVat  Float    @default(0)   // 1 case 합계(VAT 별도)
  totalAmount     Float    @default(0)   // 총 납품 예상가(VAT 포함)

  status          String   @default("draft") // draft, confirmed, closed
  validUntil      DateTime?
  note            String?

  materials       DetailedMaterialItem[]
  supplies        DetailedSupplyItem[]
  processes       DetailedProcessItem[]
  overheads       DetailedOverheadItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 상세견적서 원료 항목
model DetailedMaterialItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id])
  materialName    String
  specification   String?
  mixRatio        Float    @default(0)
  contentMg       Float    @default(0)
  inputKg         Float    @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  functionalContent String?
  note            String?
}

// 상세견적서 자재 항목
model DetailedSupplyItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  supplyId        String?
  supply          Supply? @relation(fields: [supplyId], references: [id])
  supplyName      String
  specification   String?
  quantity        Int      @default(0)
  inputQty        Int      @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  note            String?
}

// 상세견적서 공정 항목
model DetailedProcessItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  processId       String?
  process         Process? @relation(fields: [processId], references: [id])
  processName     String
  quantity        Int      @default(0)
  unitCost        Float    @default(0)
  totalCost       Float    @default(0)
  note            String?
}

// 상세견적서 간접제조비 항목 (검사비/관리비/운반비/디자인비/1회성비용 등 가변)
model DetailedOverheadItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  name            String
  amount          Float    @default(0)
  note            String?
}

// 자재 마스터
model Supply {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  unit          String   @default("개")
  unitPrice     Float    @default(0)
  specification String?

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  capacity      Float?    // 용량 (20, 30, 110 ...)
  capacityUnit  String?   // ml, g
  color         String?   // 갈색, 유광 금색
  printed       String?   // 인쇄유무
  origin        String?   // 미국, 프랑스
  vialType      String?   // Flip-Top, TE
  boxQty        Int?      // 박스 입수
  moq           Int?
  effectiveDate DateTime?
  sourceFile    String?   // 근거 파일명

  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedItems DetailedSupplyItem[]
  packagingItems PackagingSetItem[]
}

// 공정 마스터
model Process {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  unitCost      Float    @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedItems DetailedProcessItem[]
}

// 임가공 단가 — "업체 x 제형 x 규격구간 x 수량구간" 복합 조건으로 관리한다
model TollingRate {
  id             String   @id @default(cuid())

  vendorId       String?
  vendor         Supplier? @relation(fields: [vendorId], references: [id])
  vendorName     String                    // 업체명 (마스터 미등록 업체 대비 텍스트 보관)

  productTypeId  String?
  productType    ProductType? @relation(fields: [productTypeId], references: [id])
  formName       String                    // 유형/제형 이름 (액상스틱, 20ml 바이알 ...)
  formCode       String?

  specLabel      String?                   // "10~15g", "250ml까지", "155mg"
  specMin        Float?
  specMax        Float?
  specUnit       String?                   // g, ml, mg

  qtyMin         Int      @default(0)      // 수량 구간 시작
  qtyMax         Int?                      // null 이면 이상(제한 없음)

  unitCost       Float    @default(0)      // 임가공 단가
  costBasis      String   @default("per_unit") // per_unit | per_case | per_bottle | per_tablet
  supplyMode     String   @default("bulk")     // bulk(벌크) | semi(반제품) | finished(완제품)

  vendorPrice    Float?                    // 납품가 (동물용 연질캅셀 40원)
  ownMargin      Float?                    // 자사 마진 (회사 10원)

  includesProfit Boolean  @default(false)
  includesVat    Boolean  @default(false)
  isNegotiable   Boolean  @default(false)  // NEGO 가능 / 협의필요
  isConfidential Boolean  @default(false)  // 대외비

  effectiveDate  DateTime @default(now())  // 단가 기준일
  endDate        DateTime?
  isCurrent      Boolean  @default(true)
  sourceFile     String?                   // 근거 파일명
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([formName, qtyMin])
  @@index([vendorName])
}

// 추가 공정비 — 추출/코팅/과립/정제포장/완포장 등 기본 가공비 외 비용
model TollingExtra {
  id            String   @id @default(cuid())
  code          String?
  name          String

  vendorId      String?
  vendor        Supplier? @relation(fields: [vendorId], references: [id])
  vendorName    String?

  productTypeId String?
  productType   ProductType? @relation(fields: [productTypeId], references: [id])
  formName      String?

  calcType      String   @default("per_unit") // per_unit(개당) | per_lot(건당) | percent(정률)
  amount        Float    @default(0)
  percentBase   String?                        // percent 일 때 기준 (cost_subtotal 등)

  isOptional    Boolean  @default(true)
  condition     String?                        // "PVC 별도청구", "30만T 미만 물류비" 등

  effectiveDate DateTime @default(now())
  isCurrent     Boolean  @default(true)
  sourceFile    String?
  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 부자재 세트 — 용기/캡/라벨/필름처럼 함께 묶여 다니는 자재 구성
model PackagingSet {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String

  productTypeId String?
  productType   ProductType? @relation(fields: [productTypeId], references: [id])
  formName      String?

  capacity      Float?
  capacityUnit  String?

  vendorId      String?
  vendor        Supplier? @relation(fields: [vendorId], references: [id])
  vendorName    String?

  effectiveDate DateTime @default(now())
  isCurrent     Boolean  @default(true)
  sourceFile    String?
  note          String?

  items         PackagingSetItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 부자재 세트 구성 항목
model PackagingSetItem {
  id          String   @id @default(cuid())
  setId       String
  set         PackagingSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  sortOrder   Int      @default(1)
  supplyId    String?
  supply      Supply?  @relation(fields: [supplyId], references: [id])
  name        String
  spec        String?
  unitPrice   Float    @default(0)
  qtyPerUnit  Float    @default(1)   // 완제품 1개당 투입 수량
  isFreeIssue Boolean  @default(false) // 사급(고객 제공) 여부 - 원가에서 제외
  note        String?
}

// 임포트 매핑 템플릿
model ImportTemplate {
  id            String   @id @default(cuid())
  name          String
  targetTable   String   // material, supply, process, customer, productType
  mappingConfig String   // JSON: [{ sourceColumn, targetField }]
  options       String?  // JSON: { duplicateHandling, emptyValueHandling, newOnly }
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  importHistories ImportHistory[]
}

// 임포트 이력
model ImportHistory {
  id            String   @id @default(cuid())
  templateId    String?
  template      ImportTemplate? @relation(fields: [templateId], references: [id])
  fileName      String
  fileType      String   // xlsx, csv, pdf
  targetTable   String
  totalRows     Int      @default(0)
  successCount  Int      @default(0)
  errorCount    Int      @default(0)
  warningCount  Int      @default(0)
  status        String   @default("pending") // pending, processing, success, partial, failed
  errorLog      String?  // JSON array of errors
  createdBy     String?
  createdAt     DateTime @default(now())
}

// 고객사
model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contact       String?
  manager       String?
  address       String?
  email         String?
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedQuotations DetailedQuotation[]
}

// AI 프로바이더 설정
// 견적서 특기사항 기본 문구 — 모든 견적서에 공통으로 들어가는 안내
// 신규 작성 시 isActive 인 항목이 sortOrder 순으로 자동 입력된다.
model QuotationNoteTemplate {
  id        String   @id @default(cuid())
  /// 번호는 저장하지 않는다. 표시할 때 순서대로 붙인다.
  content   String
  /// 적용 대상 — ALL(항상) / HEALTH_FOOD(건강기능식품만) / NON_HEALTH_FOOD(그 외만)
  appliesTo String   @default("ALL")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// 자사(공급자) 정보 — 견적서에 찍히는 값. 항상 1행만 쓴다(id="default")
model CompanyInfo {
  id          String   @id @default("default")
  companyName String   @default("")
  ceo         String   @default("")
  bizNo       String   @default("")
  manager     String   @default("")
  tel         String   @default("")
  fax         String   @default("")
  email       String   @default("")
  address     String   @default("")
  bizType     String   @default("")
  bizItem     String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AiSetting {
  id            String   @id @default(cuid())
  providerName  String   @unique // llama_5060ti, llama_780m, openai, claude
  displayName   String
  baseUrl       String
  apiKey        String?
  modelName     String
  priority      Int      @default(0) // 낮을수록 우선
  isActive      Boolean  @default(true)
  maxTokens     Int      @default(2048)
  temperature   Float    @default(0.7)
  description   String?
  lastTestedAt  DateTime?
  lastTestResult String? // success, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 문의 게시판
model BoardInquiry {
  id              String   @id @default(cuid())
  title           String
  content         String
  authorName      String
  authorEmail     String?
  authorPhone     String?
  status          String   @default("pending") // pending, ai_processing, ai_completed, human_review, responded, closed
  inquiryType     String?  // quotation, product, simple, spam, urgent
  priority        String   @default("normal") // low, normal, high, urgent
  confidence      Float?   // AI 분류 신뢰도
  extractedData   String?  // JSON: 추출된 핵심 정보
  aiResponse      String?  // AI 생성 답변
  adminResponse   String?  // 관리자 수동 답변
  processedAt     DateTime?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// AI 처리 로그
model AiProcessingLog {
  id              String   @id @default(cuid())
  taskType        String   // classify, extract, function_call, generate_response, chat
  providerUsed    String   // 실제 사용된 프로바이더
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0) // 응답 시간 (ms)
  isSuccess       Boolean  @default(true)
  isFallback      Boolean  @default(false) // 폴백으로 처리됐는지
  fallbackFrom    String?  // 원래 시도한 프로바이더
  errorMessage    String?
  relatedId       String?  // 관련 문의/세션 ID
  functionCalls   String?  // JSON: 호출된 함수 목록
  createdAt       DateTime @default(now())
}

// AI 채팅 세션
model AiChatSession {
  id          String   @id @default(cuid())
  title       String   @default("새 대화")
  summary     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    AiChatMessage[]
}

// AI 채팅 메시지
model AiChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String   // user, assistant, function
  content     String
  functionName String?  // function 역할일 때 함수명
  functionArgs String?  // JSON: 함수 인자
  functionResult String? // JSON: 함수 실행 결과
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())
}
