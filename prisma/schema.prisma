generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 제품유형
model ProductType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  formCode       String?  // TABLET, POWDER_STICK, LIQUID_STICK, JELLY_STICK, VIAL, SOFTCAPSULE ...
  category       String?  // 고형 / 액상 / 젤리 / 용기형 / 융복합
  defaultMoq     Int?     // 제형 기본 MOQ
  processingCost Float    @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  simpleQuotations SimpleQuotation[]
  processingCosts  ProcessingCost[]
  tollingRates     TollingRate[]
  tollingExtras    TollingExtra[]
}

// 가공비 이력
model ProcessingCost {
  id            String   @id @default(cuid())
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  cost          Float
  effectiveDate DateTime
  endDate       DateTime?
  changeReason  String?
  changedBy     String?
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 공급사
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("material") // material(원료) | tolling(임가공) | packaging(용기/자재)
  contact   String?
  manager   String?
  address   String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials     Material[]
  supplies      Supply[]
  tollingRates  TollingRate[]
  tollingExtras TollingExtra[]
}

// 원료
model Material {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  code          String   @unique
  name          String
  category      String   @default("일반식품") // 건기식/일반식품
  origin        String?
  specification String?
  unit          String   @default("kg")
  unitPrice     Float
  minOrderQty   Float?
  isFunctional  Boolean  @default(false)
  certifications String?
  note          String?
  updatedBy     String?  @default("관리자")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  priceHistory  MaterialPrice[]
  detailedItems DetailedMaterialItem[]
}

// 원료 가격 이력
model MaterialPrice {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  price        Float
  effectiveDate DateTime
  endDate      DateTime?
  changedBy    String?
  createdAt    DateTime @default(now())
}

// 일반견적서
model SimpleQuotation {
  id              String   @id @default(cuid())
  quotationNo     String   @unique
  productName     String
  customerName    String?

  productTypeId   String
  productType     ProductType @relation(fields: [productTypeId], references: [id])

  packageUnit     Int
  bottleBoxCost   Float    @default(0)
  setCount        Int      @default(1)

  totalMaterialCost Float  @default(0)
  totalAmount       Float  @default(0)

  note            String?

  items           SimpleQuotationItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 일반견적서 원료 항목
model SimpleQuotationItem {
  id                String   @id @default(cuid())
  quotationId       String
  quotation         SimpleQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder         Int
  category          String
  materialName      String
  theoryAmount      Float    @default(0)
  actualAmount      Float    @default(0)
  kgUnitPrice       Float    @default(0)
  materialCost      Float    @default(0)
  origin            String?
}

// 상세견적서
model DetailedQuotation {
  id              String   @id @default(cuid())
  quotationNo     String   @unique
  productName     String
  customerName    String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  productType     String
  formType        String?
  contentAmount   Float?
  packageUnit     Int      @default(0)
  intakeGuide     String?

  // 제조 정보
  productionQty   Int      @default(0)   // 제조단위(총 생산 개수)
  unitWeight      Float    @default(0)   // 단위중량 CASE(g) = 내용량 x 포장단위
  totalWeight     Float    @default(0)   // 총중량(kg) = 내용량 x 제조단위 x 로스율 / 1000
  lossRate        Float    @default(1.1) // 총중량 산출 로스율 배수
  yieldRate       Float    @default(100) // 수율(%)
  theoreticalQty  Int      @default(0)   // 이론수량(case) = 제조단위 / 포장단위
  caseQty         Int      @default(0)   // 실제수량(case) - 1 case 원가 환산의 분모
  packagingMethod String?

  profitRate      Float    @default(5)   // 기업이윤(%)
  vatRate         Float    @default(10)  // 부가세율(%)
  finalUnitPrice  Float    @default(0)   // 확정 납품단가(VAT 포함, 수동 올림값)

  // 계산 스냅샷 - 저장 시점의 금액을 고정해 소급 변경을 막는다
  materialCost    Float    @default(0)   // 원료비 총액
  supplyCost      Float    @default(0)   // 자재비 총액
  processCost     Float    @default(0)   // 직접제조비 총액
  overheadCost    Float    @default(0)   // 간접제조비 총액
  costSubtotal    Float    @default(0)   // 1 case 원가
  profitAmount    Float    @default(0)   // 1 case 기업이윤
  unitPriceExVat  Float    @default(0)   // 1 case 합계(VAT 별도)
  totalAmount     Float    @default(0)   // 총 납품 예상가(VAT 포함)

  status          String   @default("draft") // draft, confirmed, closed
  validUntil      DateTime?
  note            String?

  materials       DetailedMaterialItem[]
  supplies        DetailedSupplyItem[]
  processes       DetailedProcessItem[]
  overheads       DetailedOverheadItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 상세견적서 원료 항목
model DetailedMaterialItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id])
  materialName    String
  specification   String?
  mixRatio        Float    @default(0)
  contentMg       Float    @default(0)
  inputKg         Float    @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  functionalContent String?
  note            String?
}

// 상세견적서 자재 항목
model DetailedSupplyItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  supplyId        String?
  supply          Supply? @relation(fields: [supplyId], references: [id])
  supplyName      String
  specification   String?
  quantity        Int      @default(0)
  inputQty        Int      @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  note            String?
}

// 상세견적서 공정 항목
model DetailedProcessItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  processId       String?
  process         Process? @relation(fields: [processId], references: [id])
  processName     String
  quantity        Int      @default(0)
  unitCost        Float    @default(0)
  totalCost       Float    @default(0)
  note            String?
}

// 상세견적서 간접제조비 항목 (검사비/관리비/운반비/디자인비/1회성비용 등 가변)
model DetailedOverheadItem {
  id              String   @id @default(cuid())
  quotationId     String
  quotation       DetailedQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sortOrder       Int
  name            String
  amount          Float    @default(0)
  note            String?
}

// 자재 마스터
model Supply {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  unit          String   @default("개")
  unitPrice     Float    @default(0)
  specification String?

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  capacity      Float?    // 용량 (20, 30, 110 ...)
  capacityUnit  String?   // ml, g
  color         String?   // 갈색, 유광 금색
  printed       String?   // 인쇄유무
  origin        String?   // 미국, 프랑스
  vialType      String?   // Flip-Top, TE
  boxQty        Int?      // 박스 입수
  moq           Int?
  effectiveDate DateTime?
  sourceFile    String?   // 근거 파일명

  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedItems DetailedSupplyItem[]
}

// 공정 마스터
model Process {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  unitCost      Float    @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedItems DetailedProcessItem[]
}

// 임가공 단가 — "업체 x 제형 x 규격구간 x 수량구간" 복합 조건으로 관리한다
model TollingRate {
  id             String   @id @default(cuid())

  vendorId       String?
  vendor         Supplier? @relation(fields: [vendorId], references: [id])
  vendorName     String                    // 업체명 (마스터 미등록 업체 대비 텍스트 보관)

  productTypeId  String?
  productType    ProductType? @relation(fields: [productTypeId], references: [id])
  formName       String                    // 유형/제형 이름 (액상스틱, 20ml 바이알 ...)
  formCode       String?

  specLabel      String?                   // "10~15g", "250ml까지", "155mg"
  specMin        Float?
  specMax        Float?
  specUnit       String?                   // g, ml, mg

  qtyMin         Int      @default(0)      // 수량 구간 시작
  qtyMax         Int?                      // null 이면 이상(제한 없음)

  unitCost       Float    @default(0)      // 임가공 단가
  costBasis      String   @default("per_unit") // per_unit | per_case | per_bottle | per_tablet
  supplyMode     String   @default("bulk")     // bulk(벌크) | semi(반제품) | finished(완제품)

  vendorPrice    Float?                    // 납품가 (동물용 연질캅셀 40원)
  ownMargin      Float?                    // 자사 마진 (회사 10원)

  includesProfit Boolean  @default(false)
  includesVat    Boolean  @default(false)
  isNegotiable   Boolean  @default(false)  // NEGO 가능 / 협의필요
  isConfidential Boolean  @default(false)  // 대외비

  effectiveDate  DateTime @default(now())  // 단가 기준일
  endDate        DateTime?
  isCurrent      Boolean  @default(true)
  sourceFile     String?                   // 근거 파일명
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([formName, qtyMin])
  @@index([vendorName])
}

// 추가 공정비 — 추출/코팅/과립/정제포장/완포장 등 기본 가공비 외 비용
model TollingExtra {
  id            String   @id @default(cuid())
  code          String?
  name          String

  vendorId      String?
  vendor        Supplier? @relation(fields: [vendorId], references: [id])
  vendorName    String?

  productTypeId String?
  productType   ProductType? @relation(fields: [productTypeId], references: [id])
  formName      String?

  calcType      String   @default("per_unit") // per_unit(개당) | per_lot(건당) | percent(정률)
  amount        Float    @default(0)
  percentBase   String?                        // percent 일 때 기준 (cost_subtotal 등)

  isOptional    Boolean  @default(true)
  condition     String?                        // "PVC 별도청구", "30만T 미만 물류비" 등

  effectiveDate DateTime @default(now())
  isCurrent     Boolean  @default(true)
  sourceFile    String?
  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 임포트 매핑 템플릿
model ImportTemplate {
  id            String   @id @default(cuid())
  name          String
  targetTable   String   // material, supply, process, customer, productType
  mappingConfig String   // JSON: [{ sourceColumn, targetField }]
  options       String?  // JSON: { duplicateHandling, emptyValueHandling, newOnly }
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  importHistories ImportHistory[]
}

// 임포트 이력
model ImportHistory {
  id            String   @id @default(cuid())
  templateId    String?
  template      ImportTemplate? @relation(fields: [templateId], references: [id])
  fileName      String
  fileType      String   // xlsx, csv, pdf
  targetTable   String
  totalRows     Int      @default(0)
  successCount  Int      @default(0)
  errorCount    Int      @default(0)
  warningCount  Int      @default(0)
  status        String   @default("pending") // pending, processing, success, partial, failed
  errorLog      String?  // JSON array of errors
  createdBy     String?
  createdAt     DateTime @default(now())
}

// 고객사
model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contact       String?
  manager       String?
  address       String?
  email         String?
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailedQuotations DetailedQuotation[]
}

// AI 프로바이더 설정
model AiSetting {
  id            String   @id @default(cuid())
  providerName  String   @unique // llama_5060ti, llama_780m, openai, claude
  displayName   String
  baseUrl       String
  apiKey        String?
  modelName     String
  priority      Int      @default(0) // 낮을수록 우선
  isActive      Boolean  @default(true)
  maxTokens     Int      @default(2048)
  temperature   Float    @default(0.7)
  description   String?
  lastTestedAt  DateTime?
  lastTestResult String? // success, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 문의 게시판
model BoardInquiry {
  id              String   @id @default(cuid())
  title           String
  content         String
  authorName      String
  authorEmail     String?
  authorPhone     String?
  status          String   @default("pending") // pending, ai_processing, ai_completed, human_review, responded, closed
  inquiryType     String?  // quotation, product, simple, spam, urgent
  priority        String   @default("normal") // low, normal, high, urgent
  confidence      Float?   // AI 분류 신뢰도
  extractedData   String?  // JSON: 추출된 핵심 정보
  aiResponse      String?  // AI 생성 답변
  adminResponse   String?  // 관리자 수동 답변
  processedAt     DateTime?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// AI 처리 로그
model AiProcessingLog {
  id              String   @id @default(cuid())
  taskType        String   // classify, extract, function_call, generate_response, chat
  providerUsed    String   // 실제 사용된 프로바이더
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0) // 응답 시간 (ms)
  isSuccess       Boolean  @default(true)
  isFallback      Boolean  @default(false) // 폴백으로 처리됐는지
  fallbackFrom    String?  // 원래 시도한 프로바이더
  errorMessage    String?
  relatedId       String?  // 관련 문의/세션 ID
  functionCalls   String?  // JSON: 호출된 함수 목록
  createdAt       DateTime @default(now())
}

// AI 채팅 세션
model AiChatSession {
  id          String   @id @default(cuid())
  title       String   @default("새 대화")
  summary     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    AiChatMessage[]
}

// AI 채팅 메시지
model AiChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String   // user, assistant, function
  content     String
  functionName String?  // function 역할일 때 함수명
  functionArgs String?  // JSON: 함수 인자
  functionResult String? // JSON: 함수 실행 결과
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())
}
